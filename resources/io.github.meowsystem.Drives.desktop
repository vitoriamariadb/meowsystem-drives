[Desktop Entry]
Name=Drives
Name[cs]=Disky
Name[pl]=Dyski
Name[pt]=Discos
Name[pt_BR]=Discos
Comment=Manage mounted drives from the panel
Comment[pt]=Gerencie os discos montados pelo painel
Comment[pt_BR]=Gerencie os discos montados pelo painel
Exec=meowsystem-drives
Terminal=false
Type=Application
StartupNotify=true
NotShowIn=COSMIC
Icon=io.github.meowsystem.Drives-symbolic
Categories=COSMIC;Utility;
Keywords=Folder;Manager;
Keywords[pl]=Folder;Katalog;Menadżer;
MimeType=inode/directory;
NoDisplay=true
X-CosmicApplet=true
X-CosmicHoverPopup=Auto
X-CosmicShrinkable=true
