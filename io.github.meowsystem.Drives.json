{
  "id": "io.github.meowsystem.Drives",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "25.08",
  "sdk": "org.freedesktop.Sdk",
  "sdk-extensions": ["org.freedesktop.Sdk.Extension.rust-stable"],
  "base": "com.system76.Cosmic.BaseApp",
  "base-version": "stable",
  "finish-args": [
    "--socket=wayland",
    "--socket=fallback-x11",
    "--talk-name=com.system76.CosmicSettingsDaemon.*",
    "--talk-name=com.system76.CosmicSettingsDaemon",
    "--talk-name=org.freedesktop.Flatpak",
    "--filesystem=xdg-config/cosmic:rw",
    "--filesystem=host",
    "--share=ipc"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin",
    "env": {
      "CARGO_HOME": "/run/build/meowsystem-drives/cargo"
    }
  },
  "modules": [
    {
      "name": "meowsystem-drives",
      "buildsystem": "simple",
      "build-commands": [
        "cargo --offline fetch --manifest-path Cargo.toml --verbose",
        "cargo --offline build --release --features flatpak --verbose",
        "install -Dm755 ./target/release/meowsystem-drives -t /app/bin",
        "install -Dm644 ./resources/io.github.meowsystem.Drives.desktop /app/share/applications/io.github.meowsystem.Drives.desktop",
        "install -Dm644 ./resources/io.github.meowsystem.Drives.metainfo.xml /app/share/metainfo/io.github.meowsystem.Drives.metainfo.xml",
        "install -Dm644 ./resources/io.github.meowsystem.Drives-symbolic.svg /app/share/icons/hicolor/scalable/apps/io.github.meowsystem.Drives-symbolic.svg"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "./"
        },
        "./flatpak/cargo-sources.json"
      ]
    }
  ]
}
